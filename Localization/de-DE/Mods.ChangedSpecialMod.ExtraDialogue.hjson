DD2Bartender: {
	NPC: {
		Puro: None
		Prototype: None
		Scientist: Was ist denn mit Doktor K los? Gestern hat er mich gefragt, ob ich seinen selbstgebrannten Schnaps aus Toilettenpapier verkaufen will.
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: None
		WhiteCub: None
		SquidDog: Hast du wirklich so viele Arme? Oder sehe ich doppelt wegen des vielen Biers?
	}
}

Demolitionist: {
	NPC: {
		Puro: None
		Prototype: None
		Scientist: None
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: Hast du schon mal von explosiven Kaninchen gehört? Möchtest du, dass ich dir Dynamit umbinde, damit du ein explosiver Welpe wirst?
		WhiteCub: Hast du schon mal von explosiven Kaninchen gehört? Möchtest du, dass ich dir Dynamit umbinde, damit du ein explosiver Welpe wirst?
		SquidDog: Verschwinde, Monster! Sonst hole ich die Wasserbomben!
	}
}

