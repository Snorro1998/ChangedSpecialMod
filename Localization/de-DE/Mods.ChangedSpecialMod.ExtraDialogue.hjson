DyeTrader: {
	NPC: {
		Puro: None
		Prototype: None
		Scientist: Doktor K mag zwar ein Experte für Bioingenieurwesen sein, aber von Mode hat er keine Ahnung.
	}

	Transfur: {
		BlackGoop: Ah! Warum läuft der schwarze Farbstoff?
		WhiteGoop: Ah! Warum läuft der weiße Farbstoff?
		BlackCub: None
		WhiteCub: None
		SquidDog: Lass deine nassen Pfoten von meinem Bademantel fern! Ich will nicht, dass die Farben verblassen!
	}
}

Golfer: {
	NPC: {
		Puro: None
		Prototype: None
		Scientist: Kannst du ein Geheimnis bewahren? Ich habe versehentlich ein paar Sachen von Doktor K kaputt gemacht, als ich in seinem Zimmer Golf gespielt habe.
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: None
		WhiteCub: None
		SquidDog: Hey, falls du jemals Golfbälle im Wasser findest, könntest du sie mir bitte zurückbringen?
	}
}

Guide: {
	NPC: {
		Puro: None
		Prototype: None
		Scientist: Wenn Sie mehr über die Schleimmonster erfahren möchten, ist Doktor K die beste Wahl.
	}

	Transfur: {
		BlackGoop: Pass auf, du kleiner Schleimklumpen. Jemand könnte dich versehentlich zertreten.
		WhiteGoop: Pass auf, du kleiner Schleimklumpen. Jemand könnte dich versehentlich zertreten.
		BlackCub: None
		WhiteCub: None
		SquidDog: Ich bin hier, um Ihnen einen Rat zu geben. Ich empfehle Ihnen, wieder ins Wasser zu gehen, bevor Sie austrocknen.
	}
}

Mechanic: {
	NPC: {
