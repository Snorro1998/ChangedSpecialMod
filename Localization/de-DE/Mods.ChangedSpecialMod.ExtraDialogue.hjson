Angler: {
	NPC: {
		Puro: Puro meinte, ich solle aufhören, einen Tintenfischhund zu fangen. Wenn es wirklich zu gefährlich für ein Kind ist, darfst DU einen fangen!
		Prototype: Wenn ich {NamePrototype} ins Wasser werfen würde, würde er dann alle Fische wie ein elektrischer Aal durch Stromschlag töten?
		Scientist: None
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: None
		WhiteCub: None
		SquidDog: Unmöglich! Ein Tintenfischhund! Ja, bitte bleiben Sie eine Weile hier.
	}
}

BestiaryGirl: {
	NPC: {
		Puro: Ich habe noch nie einen Wolf gesehen, der so weich und flauschig ist wie Puro!
