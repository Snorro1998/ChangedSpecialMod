Nurse: {
	NPC: {
		Puro: Ich sagte Puro, er müsse zwei Orangen am Tag essen, um gesund zu bleiben. Er meinte, er esse mindestens zehn am Tag.
		Prototype: Einmal bat ich {NamePrototype} um Hilfe bei einer Untersuchung, aber er sprühte dem Patienten einfach nur Wasser ins Gesicht.
		Scientist: None
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: None
		WhiteCub: None
		SquidDog: Sag mir bitte nicht, dass du dir alle Arme gebrochen hast.
	}
}

Painter: {
	NPC: {
		Puro: Könntest du mir noch mehr orange Farbe bringen? Puro hat mich gefragt, ob ich sein ganzes Zimmer damit streichen könnte.
		Prototype: None
		Scientist: None
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: None
		WhiteCub: None
		SquidDog: Hättest du zufällig noch Tinte für mich? Mir ist die Kohle-Schwarze Farbe ausgegangen.
	}
}

PartyGirl: {
	NPC: {
		Puro: Ich liebe es, mit Puro zu feiern! Er ist ein echter Partylöwe!
		Prototype: "{NamePrototype} ist eine echte Partymaschine. Er kann Musik abspielen und gleichzeitig als Discokugel fungieren."
		Scientist: None
	}

	Transfur: {
		BlackGoop: Wow, der Schokoladenkuchen bewegt sich! Das ist ja ein cooler Partytrick!
		WhiteGoop: Wow, der Kuchen bewegt sich! Das ist ja ein cooler Partytrick!
		BlackCub: Hallo! Bist du wegen der Haustierparty hier?
		WhiteCub: Hallo! Bist du wegen der Haustierparty hier?
		SquidDog: Lass uns tanzen! Gib mir deine Hand! Oder beide Hände. Ähm, oder... vier Hände?
	}
}

Pirate: {
	NPC: {
		Puro: Ahoi! Ich kümmere mich um den schwarzbärtigen Wolf, du Landratte. Ich liebe es, Seebären aufzuziehen!
		Prototype: None
		Scientist: Arrr, that scientist be looking as pale as a ghost. Me thinks he be cursed.
	}

	Transfur: {
		BlackGoop: Steh still, du Teerklumpen! Ich brauche dich, um das Loch in meinem Schiff zu flicken!
		WhiteGoop: Steh still, du Teerklumpen! Ich brauche dich, um das Loch in meinem Schiff zu flicken!
		BlackCub: Yar, du bist der entzückendste Seewelpe, den ich je gesehen habe!
		WhiteCub: Yar, du bist der entzückendste Seewelpe, den ich je gesehen habe!
		SquidDog: Arrr, was für ein Seeungeheuer bist du denn? Ein Krakenhund?
	}
}

SantaClaus: {
	NPC: {
		Puro: Ich kann fast alles verschenken, und dann gibt es da diese eine Person, die nichts anderes als Orangen auf ihrer Wunschliste hat.
		Prototype: Meine Elfen sollten eine Spielzeugversion von {NamePrototype} herstellen. Ich bin sicher, die Kinder würden sie lieben.
		Scientist: Ich werde Doktor K. auf die Liste der Unartigen setzen, weil er nicht an mich glaubt.
	}

	Transfur: {
		BlackGoop: None
		WhiteGoop: None
		BlackCub: Vielleicht sollte ich dich in eine Geschenkbox packen und dich jemandem schenken, der sich zu Weihnachten einen Welpen wünscht.
		WhiteCub: Vielleicht sollte ich dich in eine Geschenkbox packen und dich jemandem schenken, der sich zu Weihnachten einen Welpen wünscht.
		SquidDog: Ich weiß nicht, wer du bist, aber du stehst definitiv auf der Liste der Unartigen!
	}
}

