TaxCollector: {
	NPC: {
		Puro: Wenn dieser schwarze Gelee-Wolf nicht bald seine Miete zahlt, werde ich ihm auch noch Tiersteuer auferlegen!
		Prototype: Dank der überdimensionierten Mikrowelle namens {NamePrototype} hat sich die Energierechnung mehr als verdoppelt!
		Scientist: Doktor K. behauptete, die Miete bezahlt zu haben, aber die Zahlen stimmen nicht. Ich wette, er hat einen Doktortitel in Steuerhinterziehung!
	}

	Transfur: {
		BlackGoop: Bah! Wer hat denn vergessen, sich die Schuhe abzuputzen? Jetzt ist überall Schlamm!
		WhiteGoop: Bah! Wer hat denn vergessen, sich die Schuhe abzuputzen? Jetzt ist überall Schlamm!
		BlackCub: Hau ab, Köter! {NamePlayer} hat nur eine Lizenz für einen Hund!
		WhiteCub: Hau ab, Köter! {NamePlayer} hat nur eine Lizenz für einen Hund!
		BlackCubNoLicense: Hau ab, Köter! Und komm erst wieder, wenn {NamePlayer} eine Hundemarke gekauft hat!
		WhiteCubNoLicense: Hau ab, Köter! Und komm erst wieder, wenn {NamePlayer} eine Hundemarke gekauft hat!
		SquidDog: Hau ab! Belästige jemand anderen, du blödes Seeungeheuer!
	}
}

Wizard: {
	NPC: {
		Puro: Ich kann Puro nicht meine Zauberbücher lesen lassen. Er ist schon ein mächtiges Biest und braucht nicht auch noch Feuer zu speien.
		Prototype: None
		Scientist: Warum versucht Doktor K, meine Aktivitäten wissenschaftlich zu analysieren? Das ist doch... Magie.
	}

	Transfur: {
