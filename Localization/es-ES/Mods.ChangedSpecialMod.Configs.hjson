ChangedSpecialModClientConfig: {
	DisplayName: Configuración del cliente

	TransfurSound: {
		Label: Sonido de transformación
		Tooltip: Si se reproduce el sonido de transformación.
	}

	WhipCrackSound: {
		Tooltip: Si el 'Látigo de Molusco' y sus mejoras deberían reproducir un sonido de chasquido de látigo.
		Label: Sonido de chasquido de látigo
	}

	SlipSound: {
		Tooltip: Si un jugador resbala, se debe reproducir un efecto de sonido que indique que el jugador resbala.
		Label: Sonido de deslizamiento del jugador
	}

	NPCsCanUseChangedEmotes: {
		Tooltip: Los personajes pueden usar emoticonos sobre Changed.
		Label: Personajes pueden usar emoticonos sobre Changed
	}

	ExtraDialogue: {
		Tooltip: Si se debería añadir más diálogo a los personajes normales de Terraria.
		Label: Diálogo adicional
	}

	Headers: {
		Audio: "[c/ffeb6e:Audio]"
		Misc: "[c/ffeb6e:Misceláneos]"
		WorldGeneration: "[c/ffeb6e:Generación Mundial]"
		Transfur: "[c/ffeb6e:Transformación]"
		Npc: "[c/ffeb6e:Personajes]"
		Evolution: "[c/ffeb6e:Evolución]"
		Visuals: "[c/ffeb6e:Gráficos]"
		WorldGenerationSteps: "[c/ffeb6e:Fases de generación del mundo]"
	}

	NumberOfLabs: {
		Label: Número de laboratorios
		Tooltip:
			'''
			El número de laboratorios por lado del mundo.
			El valor predeterminado 1 generará 1 laboratorio 
			en mundos pequeños y medianos, y 2 laboratorios en mundos grandes.
			[c/ff0000:ADVERTENCIA]: Los valores grandes en mundos pequeños pueden provocar que el juego se bloquee.
			'''
	}

	MaximumFloors: {
		Label: Número máximo de pisos
		Tooltip: El número máximo de plantas que puede tener un laboratorio.
	}

	MaximumRoomsHorizontal: {
		Label: Número máximo de habitaciones horizontales
		Tooltip: El número máximo de salas que puede tener un laboratorio en dirección horizontal.
	}

	LatexSpread: {
		Label: Propagación del látex
		Tooltip: Que el látex se propague a otros bloques en el modo difícil.
	}

	LatexSpreadChance: {
		Label: Probabilidad de propagación del látex
		Tooltip: La probabilidad de que el látex se propague a otros bloques en el modo difícil es de 1 entre X.
	}

	DebugItems: {
		Label: Elementos de depuración
		Tooltip: Si está habilitada, el Dr. K. venderá elementos de depuración.
	}

	NPCsCanTransfurPlayer: {
		Label: Los personajes pueden transformar al jugador.
		Tooltip: En la mayoría de los casos, morir a manos de un monstruo te convertirá en uno de ellos.
	}

	CustomHealthBar: {
		Label: Barra de salud de color
		Tooltip: Cuando te transformes, dibuja la barra de salud en diferentes colores.
	}

	Evolution: {
		Label: Evolución
		Tooltip: Los monstruos se hacen más fuertes con cada jefe derrotado.
	}

	EvolutionSize: {
		Label: Crecimiento
		Tooltip: Los monstruos también crecerán.
	}

	DialoguePortraits: {
		Label: Retratos de personajes
		Tooltip:
			'''
			Si los personajes de este mod tienen retratos cuando se habla con ellos.
			Si se juega con "Boulder Backport" instalado, esta configuración se ignora 
			y se utiliza en su lugar la opción "Modded Town NPC Portraits".
			'''
	}

	CustomWorldNames: {
		Label: Nuevos nombres del mundo
		Tooltip: Al generar un mundo nuevo, se pueden seleccionar nombres nuevos.
	}

	CustomDryadWorldStatus: {
		Label: Información adicional sobre el estado mundial
		Tooltip: La dríada también puede decirte cuánto limo hay en el mundo.
	}

	MonstersCanWearHats: {
		Label: Los monstruos pueden usar sombreros.
		Tooltip: Cuando esta opción está activada, los monstruos pueden llevar sombreros bajo ciertas condiciones. Por ejemplo, cuando llueve o durante una fiesta.
	}

	Holidays: {
		Label: Días festivos
		Tooltip: Los habitantes del pueblo llevan sombreros durante las festividades y tienen diálogos únicos.
	}

	RetroVisualsTiles: {
		Label: Bloques antiguos
		Tooltip: Utiliza imágenes de versiones anteriores para bloques y mobiliario.
	}

	RetroVisualsNPCs: {
		Label: Personajes viejos
		Tooltip: Utiliza imágenes de versiones anteriores para los personajes.
	}

	ForceLastGenerationPass: {
		Label: Forzar la generación del mundo al final
		Tooltip:
			'''
			Si la generación del mundo debe realizarse después de todos los demás mods. 
			Esto podría solucionar problemas de superposición de biomas y estructuras, aunque no está garantizado. 
			Si esta opción está habilitada, el generador de mundos se quedará bloqueado durante un breve instante en la última etapa.
			[c/ff0000:ADVERTENCIA] ¡Activa esto solo si es necesario!
			'''
	}

	WorldGenStepSurfaceLabs: {
		Label: Laboratorios
		Tooltip: Si los laboratorios deberían construirse en la superficie.
	}

	WorldGenStepLatexCaves: {
		Label: Cuevas de limo
		Tooltip: Si las cuevas de slimes debieran generarse bajo tierra.
	}

	WorldGenStepOrangeShrine: {
		Label: Santuarios Naranjas
		Tooltip: Si las Santuarios Naranja debieran generarse bajo tierra.
	}

	ShortMusic: {
		Label: Canciones cortas
		Tooltip: Si en las zonas de limo puede sonar canciones cortas y repetitivas.
	}
}
