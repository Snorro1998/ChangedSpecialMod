ChangedSpecialModClientConfig: {
	DisplayName: Konfiguracja klienta

	TransfurSound: {
		Label: Dźwięk transformacji
		Tooltip: Czy dźwięk transformacji ma zostać odtworzony.
	}

	WhipCrackSound: {
		Tooltip: Czy broń przypominająca bicz powinna wydawać dźwięk trzasku bicza?
		Label: Dźwięk trzasku bicza
	}

	SlipSound: {
		Tooltip: Jeżeli dźwięk poślizgu ma być odtwarzany, gdy gracz się ślizga.
		Label: Dźwięk poślizgu gracza
	}

	NPCsCanUseChangedEmotes: {
		Tooltip: Kiedy postacie rozmawiają, mogą używać emotikonów dotyczących gry Changed.
		Label: Postacie mogą używać emotikonów Changed
	}

	ExtraDialogue: {
		Tooltip: Czy powinno się dodać więcej dialogów do standardowych postaci Terraria?
		Label: Dodatkowy dialog
	}

	Headers: {
		Audio: "[c/ffeb6e:Audio]"
		Misc: "[c/ffeb6e:Różnorodny]"
		WorldGeneration: "[c/ffeb6e:Generacja świata]"
		Transfur: "[c/ffeb6e:Transformacja]"
		Npc: "[c/ffeb6e:Postacie]"
		Evolution: "[c/ffeb6e:Ewolucja]"
		Visuals: "[c/ffeb6e:Grafika]"
		WorldGenerationSteps: "[c/ffeb6e:Etapy generowania świata]"
	}

	NumberOfLabs: {
		Label: Liczba laboratoriów
		Tooltip:
			'''
			Liczba laboratoriów po każdej stronie świata.
			Domyślna wartość 1 spowoduje wygenerowanie 1 laboratorium w 
			małych i średnich światach oraz 2 laboratoriów w dużych światach.
			[c/ff0000:OSTRZEŻENIE] Duże wartości w małych światach mogą spowodować zawieszenie gry.
			'''
	}

	MaximumFloors: {
		Label: Maksymalna liczba pięter
		Tooltip: Maksymalna liczba pięter, jaką może mieć laboratorium.
	}

	MaximumRoomsHorizontal: {
		Label: Maksymalna liczba pomieszczeń poziomych
		Tooltip: Maksymalna liczba pomieszczeń, jakie laboratorium może mieć w kierunku poziomym.
	}

	LatexSpread: {
		Label: Rozprzestrzenianie się szlamu
		Tooltip: Czy szlam może rozprzestrzeniać się na inne bloki w trybie hardmode?
	}

	LatexSpreadChance: {
		Label: Szansa na rozprzestrzenianie się śluzu
		Tooltip: Prawdopodobieństwo 1 do X, że szlam rozprzestrzeni się na inne bloki w trybie hardmode.
	}

	DebugItems: {
		Label: Elementy debugowania
		Tooltip: Jeśli włączone, Dr K. będzie sprzedawać przedmioty debugowe.
	}

	NPCsCanTransfurPlayer: {
		Label: Postacie mogą transformować gracza
		Tooltip: W większości przypadków, jeśli zostaniesz zabity przez śluzowatą bestię, staniesz się jednym z nich.
	}

	CustomHealthBar: {
		Label: Kolorowy pasek zdrowia
		Tooltip: Jeśli gracz ulegnie transformacji, pasek zdrowia będzie miał różne kolory.
	}

	Evolution: {
		Label: Ewolucja
		Tooltip: Bestie śluzowate staną się silniejsze po pokonaniu każdego bossa.
	}

	EvolutionSize: {
		Label: Wzrost
		Tooltip: Bestie śluzowate również staną się większe.
	}

	DialoguePortraits: {
		Label: Portrety postaci
		Tooltip:
			'''
			Czy postacie w tym modzie mają portrety, gdy z nimi rozmawiasz.
			Jeśli grasz z zainstalowanym „Boulder Backport”, to ustawienie jest ignorowane 
			i zamiast niego używana jest opcja „Modded Town NPC Portraits”.
			'''
	}

	CustomWorldNames: {
		Label: Nowe nazwy świata
		Tooltip: Podczas generowania nowego świata można wybrać nowe nazwy.
	}

	CustomDryadWorldStatus: {
		Label: Dodatkowe informacje o stanie świata
		Tooltip: Driada może również powiedzieć, ile szlamu jest na świecie.
	}

	MonstersCanWearHats: {
		Label: Potwory mogą nosić kapelusze.
		Tooltip: Gdy ta opcja jest włączona, potwory mogą nosić kapelusze w określonych warunkach – na przykład podczas deszczu lub imprezy.
	}

	Holidays: {
		Label: Święta państwowe
		Tooltip: Mieszkańcy noszą nakrycia głowy podczas świąt i mają unikalne kwestie dialogowe.
	}

	RetroVisualsTiles: {
		Label: Stare bloki
		Tooltip: Użyj grafik ze starszych wersji dla bloków i mebli
	}

	RetroVisualsNPCs: {
		Label: Stare postacie
		Tooltip: Użyj obrazów ze starszych wersji dla postaci
	}

	ForceLastGenerationPass: {
		Label: Wymuś generowanie świata na końcu
		Tooltip:
			'''
			Określa, czy generowanie świata ma odbywać się po załadowaniu wszystkich pozostałych modów. 
			Może to – choć nie daje gwarancji – rozwiązać problemy z nakładającymi się biomami i strukturami. 
			Włączenie tej opcji spowoduje, że na ostatnim etapie generowania świata proces ten na chwilę „zawiesi się”.
			[c/ff0000:OSTRZEŻENIE] Włączaj to tylko wtedy, gdy jest to konieczne!
			'''
	}

	WorldGenStepSurfaceLabs: {
		Label: Laboratoria
		Tooltip: Czy laboratoria powinny być budowane na powierzchni?
	}

	WorldGenStepLatexCaves: {
		Label: Śluzowe jaskinie
		Tooltip: Jeśli jaskinie ze szlamem miałyby generować się pod ziemią.
	}

	WorldGenStepOrangeShrine: {
		Label: Sanktuaria pomarańczy
		Tooltip: Jeśli sanktuaria pomarańczy miałyby powstać pod ziemią.
	}

	WorldGenStepUndergroundLab: {
		Label: Podziemne laboratorium
		Tooltip: Gdyby miało powstać podziemne laboratorium.
	}

	ShortMusic: {
		Label: Krótkie piosenki
		Tooltip: W strefach ze szlamem może być odtwarzana krótka i powtarzalna muzyka.
	}
}
