ChangedSpecialModClientConfig: {
	DisplayName: クライアント設定

	TransfurSound: {
		Label: 変身効果音
		Tooltip: プレイヤーが変身する際、効果音を再生する。
	}

	WhipCrackSound: {
		Tooltip: 鞭を使用する際、効果音を再生する。
		Label: 鞭の音効果音
	}

	SlipSound: {
		Tooltip: プレイヤーが滑ったときに音を再生する。
		Label: 滑る音
	}

	NPCsCanUseChangedEmotes: {
		Tooltip: キャラクターは「Changed」に関するエモートを使用できます。
		Label: 『Changed』の絵文字
	}

	ExtraDialogue: {
		Tooltip: 『Changed』の標準的なキャラクターたちに、セリフを追加する。
		Label: 追加の会話
	}

	Headers: {
		Audio: "[c/ffeb6e:音]"
		Misc: "[c/ffeb6e:その他]"
		WorldGeneration: "[c/ffeb6e:ワールド生成]"
		Transfur: "[c/ffeb6e:変容]"
		Npc: "[c/ffeb6e:登場人物]"
		Evolution: "[c/ffeb6e:進化]"
		Visuals: "[c/ffeb6e:ビジュアル]"
		WorldGenerationSteps: "[c/ffeb6e:ワールド生成のステップ]"
	}

	NumberOfLabs: {
		Label: 研究室の数
		Tooltip:
			'''
			半球あたりの研究所の数。
			デフォルト値の1を設定すると、小規模および中規模のワールドには1つの研究所が、大規模なワールドには2つの研究所が生成されます。
			[c/ff0000:警告]：小さなワールドで大きな値を設定すると、ゲームがクラッシュする可能性があります。
			'''
	}

	MaximumFloors: {
		Label: 階数
		Tooltip: 研究施設が持つことのできる階数の最大値。
	}

	MaximumRoomsHorizontal: {
		Label: 水平方向の最大部屋数
		Tooltip: 研究室が水平方向に持つことのできる部屋の最大数。
	}

	LatexSpread: {
		Label: スライムが広がる
		Tooltip: ハードモードにおいて、スライムが他のブロックに広がる可能性がある場合。
	}

	LatexSpreadChance: {
		Label: スライムが広がる確率
		Tooltip: ハードモードにおいて、スライムが他のブロックに広がる確率は1/Xである。
	}

	DebugItems: {
		Label: デバッグ用アイテム
		Tooltip: このオプションを有効にすると、ドクターKがデバッグ用アイテムを販売するようになります。
	}

	NPCsCanTransfurPlayer: {
		Label: キャラクターはプレイヤーを変容させうる。
		Tooltip: スライムの魔物に殺されると、多くの場合、自分もスライムの魔物に変えられてしまう。
	}

	CustomHealthBar: {
		Label: 色付きの体力バー
		Tooltip: 変身時には、体力バーが異なる色で描画されます。
	}

	Evolution: {
		Label: 進化
		Tooltip: スライムの魔物は、ボスを倒すたびに強くなっていく。
	}

	EvolutionSize: {
		Label: 成長
		Tooltip: スライムの獣は大きくなっていく。
	}

	DialoguePortraits: {
		Label: キャラクターのポートレート
		Tooltip:
			'''
			このMODの町の人々に、話しかけた際に表示されるポートレートがある場合。
			「Boulder Backport」を導入してプレイしている場合、この設定は無視され、代わりに同
			MODの「Modded Town NPC Portraits」というオプションが使用されます。
			'''
	}

	CustomWorldNames: {
		Label: 新しい世界名
		Tooltip: 新しく作成された世界には、追加の名前が付くことがある。
	}

	CustomDryadWorldStatus: {
		Label: ワールドの追加ステータス情報
		Tooltip: ドライアドは、世界にどれだけのスライムが存在するかを教えてくれます。
	}

	MonstersCanWearHats: {
		Label: モンスターは帽子をかぶることができる
		Tooltip: このオプションを有効にすると、特定の条件下でモンスターが帽子をかぶれるようになります。例えば、雨が降っている時やパーティーの最中などが挙げられます。
	}

	Holidays: {
		Label: 祝日
		Tooltip: 町の人々は帽子をかぶることができ、祝日には特別なセリフを話す。
	}

	RetroVisualsTiles: {
		Label: 古いブロック
		Tooltip: ブロックや家具には、古いバージョンのスプライトを使用する。
	}

	RetroVisualsNPCs: {
		Label: 古いキャラクター
		Tooltip: キャラクターには、古いバージョンのスプライトを使用する。
	}
	
	ForceLastGenerationPass: {
		Label: ワールド生成が最後に実行されるように強制する
		Tooltip:
			'''
			ワールド生成を他のすべてのMODの処理が終わった後に行うように設定します。 
			これにより、バイオームや構造物の重複といった問題が解消される可能性があります（ただし、必ず解消されるとは限りません）。 
			このオプションを有効にすると、ワールド生成の最終段階で処理がしばらく停止したような状態になります。
			[c/ff0000:警告] 必要な場合にのみ有効にしてください！
			'''
	}

	WorldGenStepSurfaceLabs: {
		Label: 研究所
		Tooltip: もし研究所を地表に建設すべきだとしたら。
	}

	WorldGenStepLatexCaves: {
		Label: スライムの洞窟
		Tooltip: もし地下にスライムの洞窟が生成されるとしたら。
	}

	WorldGenStepOrangeShrine: {
		Label: オレンジの祠
		Tooltip: もしオレンジの祠を地下に建設するとしたら。
	}

	ShortMusic: {
		Label: 短い音楽
		Tooltip: スライム地帯では、短く反復的な音楽が流れるようにする。
	}
}
