# All localization happens in hjson files. These files contains the display names of content and other text values that will differ between languages.
# .hjson files contain translations for the language specified in the filename. (Make sure this file is UTF-8 encoded only.)
# The possible languages are: English ("en-US"), German ("de-DE"), Italian ("it-IT"), French ("fr-FR"), Spanish ("es-ES"), Russian ("ru-RU"), Chinese ("zh-Hans"), Portuguese ("pt-BR"), and Polish ("pl-PL")
# Localization files will be automatically updated with new content. After building and reloading the mod, new entries will appear in hjson files and can then be filled in.
# Here in ExampleMod we have organized these files in a folder called Localization. A single file per language makes it extremely easy to to integrate and maintain translations.
# Comments and non-autogenerated keys will be preserved and automatically mirrored to the non-English hjson files
# For more info on localization, see https://github.com/tModLoader/tModLoader/wiki/Localization

Mods: {
	ChangedSpecialMod: {
		SizeDescription: {
			Big: Big
			Huge: Huge
			Giant: Giant
			Behemoth: Behemoth
		}

		Seasons: {
			None: None
			Valentine: Valentine
			Fiesta: Fiesta
			Oktoberfest: Oktoberfest
			Halloween: Halloween
			Xmas: Christmas
		}

		EventAnnouncement: {
			None: Everything returns to normal
			Valentine: Love is in the air!
			Fiesta: Suavemente!
			Oktoberfest: The Oktoberfest has begun!
			Halloween: It's starting to get spooky!
			Xmas: It's beginning to look a lot like Christmas!
		}

		Messages: {
			TogglePower: Use the switch to turn the power on and off.
			BossProgressionReset: Changed boss progression reset!
			WolfKingCanSpawn: You hear distant howls coming from the laboratory...
			BehemothCanSpawn: Something stirs in the White Goo zone...
			ColinCanSpawn: Someone is on their way to you...
			WIPBossFight: This boss fight is still being developed, so don't expect much for now.
			CalendarUsedNoHolidays: This item does nothing, unless you enable the holidays configuration option.
		}

		WorldGenerationPasses: {
			Labs: Building laboratories
			OrangeShrines: Building shrines
			LatexCaves: Generating slime caves
			SpecialLatexEverywhere: Spreading way too much slime
			SpecialOrange: Orange
		}

		NPCs: {
			Puro: {
				DisplayName: Black Goo
				Description: This friendly latex beast likes books, oranges and you!

				# This is what displays during all of an NPC's happiness levels.
				TownNPCMood: {
					Content: I feel pretty good right now. Especially now that you are here!
					NoHome: I'm used to having no home but I'd prefer having one.
					FarFromHome: Where am I?
					LoveSpace: I love how spacious this place is!
					DislikeCrowded: It feels a bit cramped in here. I would love to have more space for myself.
					HateCrowded: AH! It's too crowded! Human, please find a better place.
					LoveBiome: I grew up in this place, so of course I love it here.
					LikeBiome: "{BiomeName} is so nice and peaceful, just the way I like it."
					DislikeBiome: I feel like I stand out too much in {BiomeName}.
					HateBiome: AH! {BiomeName} is awful! Everything tries to eat my oranges, and me!
					LoveNPC: "{NPCName} is so cute with her big ears and fluffy tail. But not as cute as you hehehe..."
					LikeNPC: With {NPCName} around, I always feel like a party animal.
					DislikeNPC: I don't like {NPCName}, because he is always grumpy.
					HateNPC: I hate how reckless {NPCName} is! He doesn't listen to me and keeps trying to catch a Squid Dog.
					LikeNPC_Princess: "{NPCName} is so sweet, she even offered to brush my fur!"
					Princess_LovesNPC: I just can't get enough of the delicious cupcakes {NPCName} makes!
				}

				Census.SpawnCondition: White Tail defeated
			}

			Prototype: {
				DisplayName: Prototype
				Description: A prototype for mass production of household robots.

				TownNPCMood: {
					Content: ":)"
					NoHome: No home :(
					FarFromHome: Far home :(
					LoveSpace: Spacious :)
					DislikeCrowded: Busy :(
					HateCrowded: Busy >:(
					LoveBiome: "{BiomeName} :3"
					LikeBiome: "{BiomeName} :)"
					DislikeBiome: "{BiomeName} :("
					HateBiome: "{BiomeName} >:("
					LoveNPC: "{NPCName} :3"
					LikeNPC: "{NPCName} :)"
					DislikeNPC: "{NPCName} :("
					HateNPC: "{NPCName} >:("
					LikeNPC_Princess: "{NPCName} :)"
					Princess_LovesNPC: "{NPCName} :)"
				}

				Census.SpawnCondition: Behemoth defeated
			}

			UI: {
				ExampleResource: Example Resource: {0} / {1}
				InGameNotificationTitle: Thanks for playing, you are using ChangedSpecialMod!
			}

			NotPresentDuringWorldGenMessage: ChangedSpecialMod was not used to generate this world, your experience with the content of ChangedSpecialMod will be degraded

